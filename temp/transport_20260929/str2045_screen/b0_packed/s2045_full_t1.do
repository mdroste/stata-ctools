clear
quietly set obs 200000
local transport_pad ""
quietly gen str2045 v1 = cond(mod(_n,17)==0,"",substr(string(mod(_n+1,1000000),"%06.0f")+"`transport_pad'",1,2045))
quietly gen str2045 v2 = cond(mod(_n,17)==0,"",substr(string(mod(_n+2,1000000),"%06.0f")+"`transport_pad'",1,2045))
quietly datasignature
local signature "`r(datasignature)'"
_ctools_strw v1 v2
plugin call transport_io v1 v2, "packed_s2045_full_t1_r0" "1" "identity" "0"
plugin call transport_io v1 v2, "packed_s2045_full_t1_r1" "1" "identity" "0"
plugin call transport_io v1 v2, "packed_s2045_full_t1_r2" "1" "identity" "0"
plugin call transport_io v1 v2, "packed_s2045_full_t1_r3" "1" "identity" "0"
plugin call transport_io v1 v2, "packed_s2045_full_t1_r4" "1" "identity" "0"
plugin call transport_io v1 v2, "packed_s2045_full_t1_r5" "1" "identity" "0"
plugin call transport_io v1 v2, "packed_s2045_full_t1_r6" "1" "identity" "1"
quietly datasignature
assert "`r(datasignature)'" == "`signature'"
