+
+/* Pack maximum-width strings densely in a reservation bounded at 2 GiB.
+ * On demand-paged systems this avoids touching unused declared-width bytes;
+ * platforms may account for committed/virtual memory differently. If the
+ * larger reservation fails, retry the original 64-byte-per-row estimate
+ * before falling back to individual strings. The caller checks N * 64. */
+static ctools_string_arena *create_private_string_arena(size_t nobs, int str_width)
+{
+    const size_t original_capacity = nobs * 64;
+    size_t capacity = original_capacity;
+    if (str_width == STATA_STR_MAXLEN) {
+        const size_t cap = (size_t)2048 * 1024 * 1024;
+        const size_t stride = STATA_STR_MAXLEN + 1;
+        capacity = nobs <= cap / stride ? nobs * stride : cap;
+    }
+    ctools_string_arena *arena = ctools_string_arena_create(capacity,
+                                        CTOOLS_STRING_ARENA_STRDUP_FALLBACK);
+    if (!arena && capacity != original_capacity)
+        arena = ctools_string_arena_create(original_capacity,
+                                          CTOOLS_STRING_ARENA_STRDUP_FALLBACK);
+    return arena;
 }
 
