+/* For a known maximum-width fixed string, reserve virtual capacity for
+ * every declared byte but pack actual strings densely. malloc does not touch
+ * the reservation; short values therefore use short-value physical memory.
+ * Other widths retain their current paths and 64-byte arena estimate. */
+static size_t private_string_arena_capacity(size_t nobs, int str_width)
+{
+    if (str_width == STATA_STR_MAXLEN) {
+        const size_t cap = (size_t)2048 * 1024 * 1024;
+        const size_t stride = STATA_STR_MAXLEN + 1;
+        return nobs <= cap / stride ? nobs * stride : cap;
+    }
+    return nobs * 64;
