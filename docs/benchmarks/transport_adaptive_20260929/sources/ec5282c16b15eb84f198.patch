+void stata_variable_free(stata_variable *var)
+{
+    if (!var) return;
+    if (var->type == STATA_TYPE_STRING && var->string_storage == CTOOLS_STRINGS_OWNED) {
+        ctools_string_arena *arena = var->_arena;
+        if (var->data.str && (!arena || arena->has_fallback)) {
+            for (size_t i = 0; i < var->nobs; i++) {
+                char *str = var->data.str[i];
+                if (str && (!arena || !ctools_string_arena_owns(arena, str))) free(str);
+            }
+        }
+        /* Arena can exist even when pointer-vector allocation failed. */
+        ctools_string_arena_free(arena);
+    }
+    void *buffer = var->type == STATA_TYPE_STRING ? (void *)var->data.str : (void *)var->data.dbl;
+    if (var->buffer_storage == CTOOLS_BUFFER_ALIGNED) ctools_aligned_free(buffer);
+    else if (var->buffer_storage == CTOOLS_BUFFER_HEAP) free(buffer);
+    memset(var, 0, sizeof(*var));
+}
