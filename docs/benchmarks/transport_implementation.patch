+static char *copy_private_string(ctools_string_arena *arena, const char *value)
+{
+    size_t len = strlen(value) + 1;
+    if (arena && len <= arena->capacity - arena->used) {
+        char *result = arena->base + arena->used;
+        arena->used += len;
+        memcpy(result, value, len);
